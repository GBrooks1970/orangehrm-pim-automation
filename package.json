{
  "name": "orangehrm-pim-automation",
  "version": "0.1.0",
  "description": "E2E automation for the OrangeHRM PIM module using SDD, BDD and the Screenplay pattern (Serenity/JS + Playwright + Cucumber)",
  "license": "GPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "cucumber-js --profile default --tags \"not @deferred\"",
    "test:smoke:local": "cucumber-js --profile smoke",
    "test:target-contract": "ts-node scripts/verify-local-target-contract.ts",
    "test:report": "serenity-bdd run --source ./docs/reports --features ./features",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@serenity-js/console-reporter": "3.44.1",
    "@serenity-js/core": "3.44.1",
    "@serenity-js/cucumber": "3.44.1",
    "@serenity-js/playwright": "3.44.1",
    "@serenity-js/serenity-bdd": "3.44.1",
    "@serenity-js/web": "3.44.1",
    "@types/node": "^24.0.0",
    "playwright": "1.62.0",
    "ts-node": "^10.9.0",
    "typescript": "^7.0.2"
  }
}
